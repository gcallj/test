    "    df[DATE_COL] = _parse_dates_smart(df[DATE_COL])\n",
    "\n",
    "    for col in [OPEN_COL, HIGH_COL, LOW_COL, CLOSE_COL]:\n",
    "        df[col] = pd.to_numeric(df[col], errors=\"coerce\")\n",
    "\n",
    "    df = df.dropna(subset=[DATE_COL, TICKER_COL, CLOSE_COL])\n",
    "    df = df.sort_values([TICKER_COL, DATE_COL]).reset_index(drop=True)\n",
    "\n",
    "    if ONLY_SA:\n",
    "        df = df[df[TICKER_COL].str.endswith(\".SA\")].copy()\n",
    "\n",
    "    df = add_sma200(df)\n",
    "    df = add_atr_ohlc_fast(df)\n",
    "\n",
    "    # Detect potential splits/dividends (daily change > 40%)\n",
    "    daily_ret = df.groupby(TICKER_COL, sort=False)[CLOSE_COL].pct_change()\n",
    "    split_mask = daily_ret.abs() > 0.40\n",
    "    n_splits = split_mask.sum()\n",
    "    if n_splits > 0:\n",
    "        print(f\"[DATA] Detected {n_splits} potential split/dividend events, masking OHLC\")\n",
    "        for col in [OPEN_COL, HIGH_COL, LOW_COL, CLOSE_COL]:\n",
    "            df.loc[split_mask, col] = np.nan\n",
    "        df = df.dropna(subset=[CLOSE_COL])\n",
    "\n",
    "    df = add_technical_features(df)\n",
    "    return df\n",
    "\n",
    "\n",
    "def build_temporal_windows(min_date: pd.Timestamp, max_date: pd.Timestamp, train_years: int = 3, test_months: int = 6, step_months: int = 6) -> List[Tuple[pd.Timestamp, pd.Timestamp, pd.Timestamp, pd.Timestamp]]:\n",
    "    windows = []\n",
    "    cur_train_start = pd.Timestamp(min_date).normalize()\n",
    "    max_date = pd.Timestamp(max_date).normalize()\n",
    "    while True:\n",
    "        train_end = cur_train_start + pd.DateOffset(years=train_years) - pd.Timedelta(days=1)\n",
    "        test_start = train_end + pd.Timedelta(days=1)\n",
    "        test_end = test_start + pd.DateOffset(months=test_months) - pd.Timedelta(days=1)\n",
    "        if test_end > max_date:\n",
    "            break\n",
    "        windows.append((cur_train_start, train_end, test_start, test_end))\n",
    "        cur_train_start = cur_train_start + pd.DateOffset(months=step_months)\n",
    "    return windows\n",
    "\n",
    "\n",
    "def generate_signal_global(payload: Dict[str, Any], gp: GlobalParams, day_index: int) -> str:\n",
    "    x = np.asarray(payload[\"score_matrix\"], dtype=np.float64)\n",
    "    c = np.asarray(payload[\"close\"], dtype=np.float64)\n",
    "    atr = np.asarray(payload[\"atr\"], dtype=np.float64)\n",
    "    if day_index <= 0 or day_index >= len(c) or x.ndim != 2:\n",
    "        return \"hold\"\n",
    "\n",
    "    feat_n = max(1, x.shape[1])\n",
    "    votes_long = (x > gp.z_threshold).sum(axis=1) / feat_n\n",
    "    votes_short = (x < -gp.z_threshold).sum(axis=1) / feat_n\n",
    "    score_raw = votes_long - votes_short\n",
    "    score_ev = pd.Series(score_raw).ewm(span=int(gp.signal_ema_span), adjust=False).mean().to_numpy()\n",
    "    score_pctl = rolling_quantile_trigger(score_ev, float(gp.score_percentile_trigger), max(63, SCORE_LOOKBACK))\n",
    "\n",
    "    ma = pd.Series(c).rolling(int(gp.ma_filter_period), min_periods=max(20, int(gp.ma_filter_period // 2))).mean().to_numpy()\n",
    "    vol_rel = atr / np.maximum(c, ATR_EPS)\n",
    "    vol_rank = rolling_percentile_rank(vol_rel, 252)\n",
    "\n",
    "    # Efficient consecutive signal computation (O(n) pre-computation)\n",
    "    consec_long = 0\n",
    "    consec_short = 0\n",
    "    for j in range(max(1, day_index - int(gp.entry_confirmation_days) - 5), day_index):\n",
    "        vl_j = votes_long[j]\n",
    "        vs_j = votes_short[j]\n",
    "        long_raw_j = (vl_j >= gp.vote_threshold_long) and (score_ev[j] >= score_pctl[j])\n",
    "        short_raw_j = (vs_j >= gp.vote_threshold_short) and (-score_ev[j] >= score_pctl[j])\n",
    "        consec_long = (consec_long + 1) if long_raw_j else 0\n",
    "        consec_short = (consec_short + 1) if short_raw_j else 0\n",
    "\n",
    "    long_ok = consec_long >= gp.entry_confirmation_days\n",
    "    short_ok = consec_short >= gp.entry_confirmation_days\n",
    "\n",
    "    if gp.volatility_filter_percentile > 0 and np.isfinite(vol_rank[day_index - 1]) and vol_rank[day_index - 1] < gp.volatility_filter_percentile:\n",
    "        long_ok = False\n",
    "        short_ok = False\n",
    "\n",
    "    if gp.ma_filter_mode == 1 and np.isfinite(ma[day_index - 1]):\n",
    "        if c[day_index - 1] < ma[day_index - 1]:\n",
    "            # Soft filter: require stronger signal\n",
    "            long_ok = long_ok and (score_ev[day_index - 1] * 0.5 >= gp.z_threshold)\n",
    "        if c[day_index - 1] > ma[day_index - 1]:\n",
    "            short_ok = short_ok and (-score_ev[day_index - 1] * 0.5 >= gp.z_threshold)\n",
    "    elif gp.ma_filter_mode == 2 and np.isfinite(ma[day_index - 1]):\n",
    "        if c[day_index - 1] < ma[day_index - 1]:\n",
    "            long_ok = False\n",
    "        if c[day_index - 1] > ma[day_index - 1]:\n",
    "            short_ok = False\n",
    "\n",
    "    if long_ok:\n",
    "        return \"buy\"\n",
    "    if (not LONG_ONLY) and short_ok:\n",
    "        return \"sell\"\n",
    "    return \"hold\"\n",
    "\n",
    "# 4) MAIN\n",
    "# ==============================================================================\n",
    "\n",
    "\n",
    "def plot_summary(df_sum: pd.DataFrame, output_dir: str = OUTPUT_DIR):\n",
    "    \"\"\"Generate summary plots.\"\"\"\n",
    "    try:\n",
    "        import matplotlib\n",
    "        matplotlib.use(\"Agg\")\n",
    "        import matplotlib.pyplot as plt\n",
    "        \n",
    "        fig, axes = plt.subplots(1, 2, figsize=(16, 6))\n",
    "        \n",
    "        # Bar chart: OOS return vs buy_hold\n",
    "        ax = axes[0]\n",
    "        df_plot = df_sum.head(20).copy()  # top 20 tickers\n",
    "        x = range(len(df_plot))\n",
    "        w = 0.35\n",
    "        ax.bar([i - w/2 for i in x], df_plot[\"oos_return\"], w, label=\"OOS Return\", color=\"steelblue\")\n",
    "        ax.bar([i + w/2 for i in x], df_plot[\"oos_buy_hold\"], w, label=\"Buy & Hold\", color=\"orange\")\n",
    "        ax.set_xticks(list(x))\n",
    "        ax.set_xticklabels(df_plot[\"ticker\"], rotation=45, ha=\"right\", fontsize=7)\n",
    "        ax.set_ylabel(\"Return\")\n",
    "        ax.set_title(\"OOS Return vs Buy & Hold (Top 20)\")\n",
    "        ax.legend()\n",
    "        ax.axhline(y=0, color=\"gray\", linestyle=\"--\", linewidth=0.5)\n",
    "        \n",
    "        # Histogram: excess return distribution\n",
    "        ax = axes[1]\n",
    "        excess = df_sum[\"oos_excess\"].dropna()\n",
    "        ax.hist(excess, bins=min(30, max(5, len(excess)//3)), color=\"steelblue\", edgecolor=\"white\", alpha=0.8)\n",
    "        ax.axvline(x=0, color=\"red\", linestyle=\"--\", linewidth=1.5, label=\"Break-even\")\n",
    "        ax.axvline(x=excess.mean(), color=\"green\", linestyle=\"-\", linewidth=1.5, label=f\"Mean={excess.mean():.3f}\")\n",
    "        ax.set_xlabel(\"Excess Return (Strategy - B&H)\")\n",
    "        ax.set_ylabel(\"Count\")\n",
    "        ax.set_title(\"Distribution of Excess Returns\")\n",
    "        ax.legend()\n",
    "        \n",
    "        plt.tight_layout()\n",
    "        plot_path = os.path.join(output_dir, \"summary_plot.png\")\n",
    "        plt.savefig(plot_path, dpi=150)\n",
    "        plt.close(fig)\n",
    "        print(f\"[PLOT] Saved: {plot_path}\")\n",
    "    except Exception as e:\n",
    "        print(f\"[PLOT] Failed to generate plot: {e}\")\n",
    "\n",
    "def monte_carlo_reality_check(ticker_payloads: Dict[str, Dict[str, Any]], global_params, n_perms: int = 500) -> float:\n",
    "    \"\"\"Permutation test: shuffle signal timing to test if strategy edge is real.\"\"\"\n",
    "    print(f\"[MC] Running Monte Carlo reality check with {n_perms} permutations...\")\n",
    "    mc_t0 = time.perf_counter()\n",
    "    \n",
    "    # Compute actual strategy return\n",
    "    actual_returns = []\n",
    "    for tkr, payload in ticker_payloads.items():\n",
    "        if len(payload[\"close\"]) < 252:\n",
    "            continue\n",
    "        st = backtest_stats_global_intraday(\n",
    "            payload[\"open\"], payload[\"high\"], payload[\"low\"], payload[\"close\"],\n",
    "            payload[\"score_matrix\"], payload[\"atr\"], global_params, precomputed=payload\n",
    "        )\n",
    "        actual_returns.append(st[\"total_return\"] - buyhold_capped(payload[\"close\"]))\n",
    "    \n",
    "    if not actual_returns:\n",
    "        return 1.0\n",
    "    actual_mean_excess = float(np.mean(actual_returns))\n",
    "    \n",
    "    # Permutation test: circular shift of score_matrix\n",
    "    perm_better = 0\n",
    "    for perm_i in range(n_perms):\n",
    "        perm_returns = []\n",
    "        for tkr, payload in ticker_payloads.items():\n",
    "            if len(payload[\"close\"]) < 252:\n",
    "                continue\n",
    "            n = len(payload[\"close\"])\n",
    "            shift = random.randint(60, n - 60)\n",
    "            shifted_scores = np.roll(payload[\"score_matrix\"], shift, axis=0)\n",
    "            st = backtest_stats_global_intraday(\n",
    "                payload[\"open\"], payload[\"high\"], payload[\"low\"], payload[\"close\"],\n",
    "                shifted_scores, payload[\"atr\"], global_params\n",
    "            )\n",
    "            perm_returns.append(st[\"total_return\"] - buyhold_capped(payload[\"close\"]))\n",
    "        if perm_returns and np.mean(perm_returns) >= actual_mean_excess:\n",
    "            perm_better += 1\n",
    "    \n",
    "    p_value = (perm_better + 1) / (n_perms + 1)  # +1 for conservative estimate\n",
    "    mc_dt = time.perf_counter() - mc_t0\n",
    "    print(f\"[MC] p-value={p_value:.4f} (n_perms={n_perms}) | actual_excess={actual_mean_excess:.4f} | time={mc_dt:.1f}s\")\n",
    "    if p_value > 0.10:\n",
    "        print(\"[MC] WARNING: Strategy is NOT statistically significant at 10% level\")\n",
    "    elif p_value <= 0.05:\n",
    "        print(\"[MC] Strategy IS statistically significant at 5% level\")\n",
    "    return p_value\n",
    "\n",
    "def run():\n",
    "    print(\"=== GA + Walk-Forward ML (OOS) + Intraday Backtest (v2) ===\")\n",
    "    print(\"[WARN] Survivorship bias: only tickers present in data are analyzed. Delisted tickers excluded.\")\n",
    "    random.seed(RANDOM_SEED)\n",
    "    np.random.seed(RANDOM_SEED)\n",
    "\n",
    "    df = load_full_history_all_cols(HISTORY_PARQUET_PATH)\n",
    "    exclude = {DATE_COL, TICKER_COL, OPEN_COL, HIGH_COL, LOW_COL, CLOSE_COL, \"sma200\", \"sma200_slope\", \"atr\"}\n",
    "    num_cols = [c for c in df.columns if c not in exclude and pd.api.types.is_numeric_dtype(df[c])]\n",
    "    base_feat_cols = num_cols[:MAX_FEATURES]\n",
    "\n",
    "    tickers = df[TICKER_COL].dropna().unique().tolist()\n",
    "    total_tickers = len(tickers)\n",
    "    if EVAL_ONLY_TICKER:\n",
    "        t_req = str(EVAL_ONLY_TICKER).strip().upper()\n",
    "        tickers = [t for t in tickers if str(t).upper() in {t_req, f\"{t_req}.SA\"}]\n",
    "    elif TEST_ONLY_PREFIX_C_TICKERS:\n",
    "        tickers = [t for t in tickers if str(t).startswith(TEST_TICKER_PREFIX)]\n",
    "\n",
    "    print(f\"[FEATS] numeric candidates: {len(base_feat_cols)} (using up to {MAX_FEATURES})\")\n",
    "    print(f\"[DATA] {len(df)} rows, {len(tickers)} tickers (out of {total_tickers})\")\n",
    "    print(f\"[SYSTEM] CPUs available={multiprocessing.cpu_count()} | configured_workers={GA_EVAL_WORKERS}\")\n",
    "\n",
    "    out_global_ckpt = os.path.join(OUTPUT_DIR, \"global_ga_checkpoint.json\")\n",
    "    out_xlsx = os.path.join(OUTPUT_DIR, f\"summary_latest.xlsx\")\n",
    "    out_apply_csv = os.path.join(OUTPUT_DIR, f\"apply_last_{APPLY_DAYS}d__H{FWD_H}.csv\")\n",
    "\n",
    "    # FASE 1: Preparar payloads\n",
    "    prep_t0 = time.perf_counter()\n",
    "    ticker_payloads: Dict[str, Dict[str, Any]] = {}\n",
    "    reasons: Dict[str, int] = {}\n",
    "\n",
    "    for ix_tkr, tkr in enumerate(tickers, 1):\n",
    "        g = df[df[TICKER_COL] == tkr].copy()\n",
    "        if len(g) < MIN_ROWS_TICKER:\n",
    "            reasons[\"few_rows\"] = reasons.get(\"few_rows\", 0) + 1\n",
    "            continue\n",
    "\n",
    "        g = g.sort_values(DATE_COL).reset_index(drop=True)\n",
    "        c_temp = g[CLOSE_COL].to_numpy(np.float64)\n",
    "        atr_temp = g[\"atr\"].to_numpy(np.float64)\n",
    "        # Use all base features (per-window selection happens in precompute_global_payloads)\n",
    "        feat_cols = [c for c in base_feat_cols if c in g.columns]\n",
    "        if len(feat_cols) < 3:\n",
    "            reasons[\"few_feats\"] = reasons.get(\"few_feats\", 0) + 1\n",
    "            continue\n",
    "\n",
    "        directed_cols, long_votes, short_votes = build_direct_feature_signal(g, feat_cols)\n",
    "        dates = pd.to_datetime(g[DATE_COL], errors=\"coerce\").to_numpy()\n",
    "        o = g[OPEN_COL].to_numpy(np.float64)\n",
    "        h = g[HIGH_COL].to_numpy(np.float64)\n",
    "        l = g[LOW_COL].to_numpy(np.float64)\n",
    "        c = g[CLOSE_COL].to_numpy(np.float64)\n",
    "        atr = g[\"atr\"].to_numpy(np.float64)\n",
    "        ma = g[\"sma200\"].to_numpy(np.float64)\n",
    "\n",
    "        valid_cols = np.isfinite(directed_cols).any(axis=1)\n",
    "        valid_mask = np.isfinite(o) & np.isfinite(h) & np.isfinite(l) & np.isfinite(c) & np.isfinite(atr) & valid_cols\n",
    "        if valid_mask.sum() < ML_MIN_TRAIN:\n",
    "            reasons[\"few_valid\"] = reasons.get(\"few_valid\", 0) + 1\n",
    "            continue\n",
    "\n",
    "        ticker_payloads[str(tkr)] = {\n",
    "            \"open\": o, \"high\": h, \"low\": l, \"close\": c, \"atr\": atr,\n",
    "            \"score_matrix\": directed_cols, \"dates\": dates, \"ma\": ma,\n",
    "            \"feat_cols\": feat_cols, \"valid_mask\": valid_mask,\n",
    "            \"long_votes\": long_votes, \"short_votes\": short_votes,\n",
    "        }\n",
    "        if (ix_tkr % max(1, PRINT_EVERY)) == 0 or ix_tkr == len(tickers):\n",
    "            dt = time.perf_counter() - prep_t0\n",
    "            print(f\"[PHASE1] prep {ix_tkr}/{len(tickers)} | payloads={len(ticker_payloads)} | elapsed={dt:.1f}s\")\n",
    "\n",
    "    prep_dt = time.perf_counter() - prep_t0\n",
    "    print(f\"[PHASE1] done payloads={len(ticker_payloads)} in {prep_dt:.1f}s\")\n",
    "\n",
    "    if not ticker_payloads:\n",
    "        print(\"Nenhum ticker preparado.\")\n",
    "        return\n",
    "\n",
    "    # FASE 2: GA global (uma vez) com checkpoint\n",
    "    run_mode = str(RUN_MODE).strip().lower()\n",
    "    global_params = None\n",
    "    global_genome = None\n",
    "    global_fit = float(\"nan\")\n",
    "    if run_mode == \"load\" and os.path.exists(out_global_ckpt):\n",
    "        try:\n",
    "            ck = json.load(open(out_global_ckpt, \"r\", encoding=\"utf-8\"))\n",
    "            global_genome = ck.get(\"genome\", None)\n",
    "            if global_genome is not None:\n",
    "                global_params = decode_global_params(global_genome)\n",
    "                global_fit = float(ck.get(\"fitness\", np.nan))\n",
    "                print(f\"[GLOBAL_GA] loaded from checkpoint fit={global_fit:.4f}\")\n",
    "        except Exception as e:\n",
    "            print(f\"[WARN] global checkpoint load failed: {e}\")\n",
    "\n",
    "    if global_params is None:\n",
    "        dmin = pd.to_datetime(df[DATE_COL].min())\n",
    "        dmax = pd.to_datetime(df[DATE_COL].max())\n",
    "        windows = build_temporal_windows(dmin, dmax, train_years=3, test_months=6, step_months=6)\n",
    "        if not windows:\n",
    "            windows = [(dmin, dmax - pd.Timedelta(days=180), dmax - pd.Timedelta(days=179), dmax)]\n",
    "        print(f\"[GLOBAL_GA] start (windows={len(windows)}, tickers={len(ticker_payloads)})\")\n",
    "        global_params, global_genome, global_fit = run_global_ga_20params(\n",
    "            full_df=df,\n",
    "            feature_cols=base_feat_cols,\n",
    "            windows=windows,\n",
    "            pop_size=GA_POP_SIZE,\n",
    "            ngen=GA_NGEN,\n",
    "            ga_max_windows=5\n",
    "        )\n",
    "        try:\n",
    "            with open(out_global_ckpt, \"w\", encoding=\"utf-8\") as f:\n",
    "                json.dump({\"fitness\": float(global_fit), \"genome\": list(global_genome)}, f, ensure_ascii=False, indent=2)\n",
    "        except Exception as e:\n",
    "            print(f\"[WARN] global checkpoint save failed: {e}\")\n",
    "        print(f\"[GLOBAL_GA] done fit={global_fit:.4f}\")\n",
    "\n",
    "    # Monte Carlo Reality Check\n",
    "    if USE_MONTE_CARLO_REALITY_CHECK and global_params is not None:\n",
    "        mc_pvalue = monte_carlo_reality_check(ticker_payloads, global_params, n_perms=min(500, max(100, len(ticker_payloads) * 10)))\n",
    "    else:\n",
    "        mc_pvalue = np.nan\n",
    "\n",
    "    # FASE 3: apply rápido sem GA por ticker\n",
    "    # Compute OOS start date from the last WF window\n",
    "    oos_start_date = None\n",
    "    if global_genome is not None:\n",
    "        dmin = pd.to_datetime(df[DATE_COL].min())\n",
    "        dmax = pd.to_datetime(df[DATE_COL].max())\n",
    "        _windows = build_temporal_windows(dmin, dmax, train_years=3, test_months=6, step_months=6)\n",
    "        if _windows:\n",
    "            oos_start_date = _windows[-1][2]  # test_start of last window\n",
    "            print(f\"[OOS] True out-of-sample starts at {oos_start_date.strftime('%Y-%m-%d')}\")\n",
    "\n",
    "    results_summary: List[Dict[str, Any]] = []\n",
    "    results_apply: List[Dict[str, Any]] = []\n",
    "\n",
    "    for ix_tkr, (tkr, payload) in enumerate(ticker_payloads.items(), 1):\n",
    "        c = payload[\"close\"]\n",
    "        dates = payload[\"dates\"]\n",
    "        n = len(c)\n",
    "        if n < 252:\n",
    "            continue\n",
    "\n",
    "        # Backtest full history with global params\n",
    "        st = backtest_stats_global_intraday(\n",
    "            payload[\"open\"], payload[\"high\"], payload[\"low\"], payload[\"close\"],\n",
    "            payload[\"score_matrix\"], payload[\"atr\"], global_params, precomputed=payload\n",
    "        )\n",
    "\n",
    "        # OOS-only backtest\n",
    "        st_oos = st  # default to full if no OOS date\n",
    "        bh_oos = buyhold_capped(c)\n",
    "        if oos_start_date is not None:\n",
    "            oos_mask = payload[\"dates\"] >= np.datetime64(oos_start_date)\n",
    "            if oos_mask.sum() >= 60:\n",
    "                st_oos = backtest_stats_global_intraday(\n",
    "                    payload[\"open\"][oos_mask], payload[\"high\"][oos_mask],\n",
    "                    payload[\"low\"][oos_mask], payload[\"close\"][oos_mask],\n",
    "                    payload[\"score_matrix\"][oos_mask], payload[\"atr\"][oos_mask],\n",
    "                    global_params\n",
    "                )\n",
    "                bh_oos = buyhold_capped(payload[\"close\"][oos_mask])\n",
    "\n",
    "\n",
    "        # Generate apply signals for last APPLY_DAYS\n",
    "        for i in range(max(0, n - APPLY_DAYS), n):\n",
    "            sig = generate_signal_global(payload, global_params, i)\n",
    "            \n",
    "            # Calculate score_ev for the day\n",
    "            x = np.asarray(payload[\"score_matrix\"], dtype=np.float64)\n",
    "            feat_n = max(1, x.shape[1])\n",
    "            votes_long = (x > global_params.z_threshold).sum(axis=1) / feat_n\n",
    "            votes_short = (x < -global_params.z_threshold).sum(axis=1) / feat_n\n",
    "            score_raw = votes_long - votes_short\n",
    "            score_ev = pd.Series(score_raw).ewm(span=int(global_params.signal_ema_span), adjust=False).mean().to_numpy()\n",
    "            \n",
    "            # Calculate quality factor (confidence)\n",
    "            quality = compute_quality_factor(st[\"sharpe\"], st[\"total_return\"], st[\"n_trades\"] / (n / 252))\n",
    "            confidence_pct = float(np.clip(quality * 100.0, 0.0, 100.0))\n",
    "            \n",
    "            # Calculate 0-100 score\n",
    "            score95 = np.nanpercentile(np.abs(score_ev), 95) if np.isfinite(np.nanmax(np.abs(score_ev))) else 1.0\n",
    "            score95 = max(score95, ATR_EPS)\n",
    "            score_100 = (np.clip(score_ev[i] / score95, -1.0, 1.0) + 1.0) / 2.0 * 100.0\n",
    "\n",
    "            # Calculate next day entry levels\n",
    "            atr_val = payload[\"atr\"][i]\n",
    "            close_val = c[i]\n",
    "            \n",
    "            # Calculate strength\n",
    "            strength = float(np.clip(abs(score_ev[i]) / score95, 0.0, 1.0))\n",
    "            discount = global_params.entry_discount_atr_frac * (1.0 - global_params.score_strength_scaling * strength)\n",
    "            \n",
    "            best_buy = close_val - discount * atr_val\n",
    "            best_sell = close_val + discount * atr_val\n",
    "            \n",
    "            stop_loss_buy = best_buy - global_params.stop_atr_mult * atr_val\n",
    "            stop_loss_sell = best_sell + global_params.stop_atr_mult * atr_val\n",
    "            \n",
    "            results_apply.append({\n",
    "                \"Date\": pd.to_datetime(dates[i]).strftime(\"%Y-%m-%d\"),\n",
    "                \"ticker\": tkr,\n",
    "                \"close\": close_val,\n",
    "                \"signal_eod\": sig,\n",
    "                \"score_100\": score_100,\n",
    "                \"confidence_pct\": confidence_pct,\n",
    "                \"best_buy_value\": best_buy,\n",
    "                \"stop_loss_buy\": stop_loss_buy,\n",
    "                \"best_sell_value\": best_sell,\n",
    "                \"stop_loss_sell\": stop_loss_sell,\n",
    "                \"position_risk_pct\": global_params.max_loss_per_trade_pct,\n",
    "            })\n",
    "        results_summary.append({\n",
    "            \"ticker\": tkr,\n",
    "            \"oos_return\": st_oos[\"total_return\"],\n",
    "            \"oos_mdd\": st_oos[\"mdd\"],\n",
    "            \"oos_sharpe\": st_oos[\"sharpe\"],\n",
    "            \"oos_trades\": st_oos[\"n_trades\"],\n",
    "            \"oos_win_rate\": st_oos[\"win_rate\"],\n",
    "            \"oos_avg_trade\": st_oos[\"avg_trade\"],\n",
    "            \"oos_buy_hold\": bh_oos,\n",
    "            \"oos_excess\": st_oos[\"total_return\"] - bh_oos,\n",
    "            \"full_return\": st[\"total_return\"],\n",
    "            \"full_sharpe\": st[\"sharpe\"],\n",
    "            \"full_mdd\": st[\"mdd\"],\n",
    "            \"buy_hold_return\": buyhold_capped(c),\n",
    "        })\n",
    "\n",
    "    df_sum = pd.DataFrame(results_summary)\n",
    "    df_app = pd.DataFrame(results_apply)\n",
    "\n",
    "    if not df_sum.empty:\n",
    "        df_sum = df_sum.sort_values(\"oos_sharpe\", ascending=False)\n",
    "        \n",
    "        # Resumo Pós-Phase3 (OOS)\n",
    "        pct_oos_pos = (df_sum[\"oos_return\"] > 0).mean() * 100\n",
    "        pct_sharpe_pos = (df_sum[\"oos_sharpe\"] > 0).mean() * 100\n",
    "        mean_oos = df_sum[\"oos_return\"].mean()\n",
    "        med_oos = df_sum[\"oos_return\"].median()\n",
    "        mean_bh = df_sum[\"oos_buy_hold\"].mean()\n",
    "        mean_excess = df_sum[\"oos_excess\"].mean()\n",
    "        pct_beating_bh = (df_sum[\"oos_excess\"] > 0).mean() * 100\n",
    "        mean_mdd = df_sum[\"oos_mdd\"].mean()\n",
    "        \n",
    "        print(\"\\n=== RESUMO PÓS-PHASE3 (OOS) ===\")\n",
    "        print(f\"% tickers com oos_return > 0: {pct_oos_pos:.1f}%\")\n",
    "        print(f\"% tickers com oos_sharpe > 0: {pct_sharpe_pos:.1f}%\")\n",
    "        print(f\"% tickers batendo buy&hold: {pct_beating_bh:.1f}%\")\n",
    "        print(f\"Média OOS return: {mean_oos:.4f} | Mediana: {med_oos:.4f}\")\n",
    "        print(f\"Média OOS buy_hold: {mean_bh:.4f} | Média excess: {mean_excess:.4f}\")\n",
    "        print(f\"Média OOS MDD: {mean_mdd:.4f}\")\n",
    "        print(f\"Comparação: OOS return ({mean_oos:.4f}) vs buy_hold ({mean_bh:.4f})\")\n",
    "\n",
    "        # Multiple testing correction (Benjamini-Hochberg FDR)\n",
    "        from scipy.stats import norm\n",
    "        oos_excess = df_sum[\"oos_excess\"].dropna().to_numpy()\n",
    "        if len(oos_excess) > 2:\n",
    "            excess_std = max(np.std(oos_excess), 1e-8)\n",
    "            z_scores = oos_excess / excess_std\n",
    "            raw_pvals = 2 * (1 - norm.cdf(np.abs(z_scores)))  # two-sided\n",
    "            n_tests = len(raw_pvals)\n",
    "            sorted_idx = np.argsort(raw_pvals)\n",
    "            sorted_pvals = raw_pvals[sorted_idx]\n",
    "            bh_threshold = np.arange(1, n_tests + 1) / n_tests * 0.10  # FDR=10%\n",
    "            significant = sorted_pvals <= bh_threshold\n",
    "            n_sig = int(significant.sum())\n",
    "            print(f\"[STATS] Tickers significativos (FDR<0.10): {n_sig}/{n_tests}\")\n",
    "            if not np.isnan(mc_pvalue):\n",
    "                print(f\"[STATS] Monte Carlo p-value: {mc_pvalue:.4f}\")\n",
    "\n",
    "\n",
    "        # Generate plots\n",
    "        plot_summary(df_sum)\n",
    "        try:\n",
    "            with pd.ExcelWriter(out_xlsx, engine=\"xlsxwriter\") as writer:\n",
    "                df_sum.to_excel(writer, sheet_name=\"Summary\", index=False)\n",
    "                if not df_app.empty:\n",
    "                    df_app.to_excel(writer, sheet_name=\"Apply\", index=False)\n",
    "        except Exception as e:\n",
    "            print(f\"[WARN] xlsxwriter failed, trying openpyxl: {e}\")\n",
    "            with pd.ExcelWriter(out_xlsx, engine=\"openpyxl\") as writer:\n",
    "                df_sum.to_excel(writer, sheet_name=\"Summary\", index=False)\n",
    "                if not df_app.empty:\n",
    "                    df_app.to_excel(writer, sheet_name=\"Apply\", index=False)\n",
    "\n",
    "    if not df_app.empty:\n",
    "        df_app.to_csv(out_apply_csv, index=False)\n",
    "\n",
    "    print(f\"Saved: {out_xlsx} | {out_apply_csv}\")\n",
    "\n",
    "\n",
    "if __name__ == \"__main__\":\n",
    "    run()\n"
   ]
  },
